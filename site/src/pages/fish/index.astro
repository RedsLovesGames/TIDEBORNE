---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { FishExplorer } from '../../components/fish/FishExplorer';
import fishCatalog from '../../data/generated/fish.json';

const basePath = import.meta.env.BASE_URL;
---

<StarlightPage
  frontmatter={{
    title: 'Fish Explorer',
    description: 'Search and browse the current Tideborne fish catalog.',
    template: 'splash',
    tableOfContents: false,
  }}
>
  <FishExplorer
    client:load
    records={fishCatalog.records}
    basePath={basePath}
  />
</StarlightPage>
