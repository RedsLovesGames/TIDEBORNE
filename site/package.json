{
  "name": "tideborne-field-guide",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run prepare:content && astro dev",
    "prepare:content": "npm run sync:docs && npm run generate:recipes",
    "sync:docs": "node scripts/sync-docs.mjs",
    "generate:recipes": "node scripts/generate-recipes.mjs",
    "import:fish": "node scripts/import-fish-catalog.mjs",
    "build": "npm run prepare:content && astro check && astro build",
    "check": "astro check",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@astrojs/starlight": "^0.42.2",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
