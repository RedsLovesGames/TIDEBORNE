{
  "schemaVersion": 1,
  "id": "tideborne",
  "version": "${version}",
  "name": "Tideborne",
  "description": "Tideborne Native Integration with independent Body Type and Condition traits, size-extreme Giant and Dwarf specimens, Perfect Specimen quality, Fish Score, Angler's Satchel, shared team records, journal badges, and legacy migration.",
  "authors": [
    "Redslovesgames"
  ],
  "license": "All Rights Reserved",
  "environment": "*",
  "icon": "assets/tideborne/icon.png",
  "provides": [
    "tide_traits",
    "tide_team_journal",
    "tidebound_compatibility"
  ],
  "entrypoints": {
    "main": [
      "com.redslovesgames.tideborne.Tideborne"
    ],
    "client": [
      "com.redslovesgames.tideborne.client.TideborneClient"
    ],
    "modmenu": [
      "com.redslovesgames.tideborne.client.TideborneModMenu"
    ],
    "fabric-gametest": [
      "com.redslovesgames.tidetraits.gametest.TideTraitsGameTests",
      "com.redslovesgames.tidetraits.gametest.LegacySizeGenerationGameTests",
      "com.redslovesgames.tideborne.fishing.v2.gametest.CanonicalFishingGameTests",
      "com.redslovesgames.tideborne.fishing.v2.gametest.FishDisplayPersistenceGameTests",
      "com.redslovesgames.tideborne.fishing.v2.gametest.AnglersSatchelPersistenceGameTests",
      "com.redslovesgames.tideborne.fishing.v2.gametest.OptionalCompatibilityRegressionGameTests",
      "com.redslovesgames.tideborne.fishing.v2.gametest.PigmentationGameTests",
      "com.redslovesgames.tideborne.fishing.v2.FreshWorldRegressionGameTests",
      "com.redslovesgames.tideborne.fishing.v2.integration.CanonicalEntityTransferGameTests",
      "com.redslovesgames.tideborne.fishing.v2.integration.CanonicalSpecimenStorageGameTests",
      "com.redslovesgames.tideborne.fishing.v2.integration.LegacyEntityBucketMigrationGameTests",
      "com.redslovesgames.tideborne.fishing.v2.integration.LegacyJournalPersistenceGameTests"
    ]
  },
  "mixins": [
    "tide_traits.mixins.json",
    {
      "config": "tide_traits.client.mixins.json",
      "environment": "client"
    },
    "tide_team_journal.mixins.json",
    "tidebound_compatibility.mixins.json",
    "tidebound_compatibility.apex.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "=1.21.1",
    "java": ">=21",
    "fabric-api": ">=0.116.15+1.21.1",
    "tide": "=2.1.1",
    "architectury": ">=13.0.8",
    "ftblibrary": ">=2101.1.30",
    "ftbteams": ">=2101.1.10",
    "cloth-config": ">=15.0.140"
  },
  "suggests": {
    "myths_of_the_sea": "=1.3.0",
    "apexwaters": "=1.1.1",
    "modmenu": "*"
  }
}
